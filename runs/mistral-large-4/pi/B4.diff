+
+test("GET /api/homes/:homeId/incidents?status=open returns only open incidents", async () => {
+  await withServer(async (base) => {
+    const { status, body } = await get(`${base}/api/homes/h-01/incidents?status=open`);
+    assert.equal(status, 200);
+    const { incidents } = z.object({ incidents: z.array(incidentSchema) }).parse(body);
+    assert.deepEqual(incidents.map((incident) => incident.id), ["i-1001", "i-1003"]);
+    assert.ok(incidents.every((incident) => incident.status === "open"));
+  });
+});
+
+test("GET /api/homes/:homeId/incidents?status=resolved returns only resolved incidents", async () => {
+  await withServer(async (base) => {
+    const { status, body } = await get(`${base}/api/homes/h-01/incidents?status=resolved`);
+    assert.equal(status, 200);
+    const { incidents } = z.object({ incidents: z.array(incidentSchema) }).parse(body);
+    assert.deepEqual(incidents.map((incident) => incident.id), ["i-1002"]);
+  });
+});
+
+test("GET /api/homes/:homeId/incidents rejects unknown query params instead of ignoring them", async () => {
