@@ -15,3 +17,65 @@ export function formatPeak(peakDb: number | null): string {
 }
 
 export const kindLabel = { noise: "Noise", occupancy: "Occupancy", offline: "Device offline" };
+
+export type HourSeverity = IncidentKind | "none";
+
+const severityRank: Record<HourSeverity, number> = { noise: 3, occupancy: 2, offline: 1, none: 0 };
+
+export type HourCell = {
+  /** Start of the hour this cell covers, local time. */
+  start: Date;
+  /** The worst thing that started in this hour. */
+  severity: HourSeverity;
+};
+
+const HOUR_MS = 3_600_000;
+
+/**
+ * The last 24 whole hours up to `now`, oldest first, each tagged with the worst incident kind
+ * that started inside it. Incidents older than 24 hours, in the future, or with an unparseable
+ * start time are ignored.
+ */
+export function last24HourCells(
+  incidents: { kind: IncidentKind; startedAt: string }[],
+  now: Date = new Date(),
+): HourCell[] {
+  const currentHourStart = Math.floor(now.getTime() / HOUR_MS) * HOUR_MS;
+  const cells: HourCell[] = [];
+  for (let hoursAgo = 23; hoursAgo >= 0; hoursAgo--) {
+    cells.push({ start: new Date(currentHourStart - hoursAgo * HOUR_MS), severity: "none" });
+  }
+  for (const incident of incidents) {
+    const started = new Date(incident.startedAt).getTime();
+    if (Number.isNaN(started) || started > now.getTime()) continue;
+    const hourStart = Math.floor(started / HOUR_MS) * HOUR_MS;
+    const hoursAgo = (currentHourStart - hourStart) / HOUR_MS;
+    if (hoursAgo < 0 || hoursAgo > 23) continue;
+    const cell = cells[23 - hoursAgo];
+    if (severityRank[incident.kind] > severityRank[cell.severity]) {
+      cell.severity = incident.kind;
+    }
+  }
+  return cells;
+}
+
+/** "2 PM" for 14:00, in local time. */
+export function formatHour(date: Date): string {
+  const hour = date.getHours();
+  const suffix = hour < 12 ? "AM" : "PM";
+  const twelve = hour % 12 === 0 ? 12 : hour % 12;
+  return `${twelve} ${suffix}`;
+}
+
+/** Plain-language tally of a strip of hour cells, so the colours never carry the meaning alone. */
+export function summarizeHours(cells: HourCell[]): string {
+  const counts: Record<HourSeverity, number> = { noise: 0, occupancy: 0, offline: 0, none: 0 };
+  for (const cell of cells) counts[cell.severity]++;
+  const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
+  const parts: string[] = [];
+  if (counts.noise > 0) parts.push(plural(counts.noise, "noisy hour"));
+  if (counts.occupancy > 0) parts.push(plural(counts.occupancy, "occupancy hour"));
+  if (counts.offline > 0) parts.push(plural(counts.offline, "device-offline hour"));
+  parts.push(plural(counts.none, "quiet hour"));
+  return `Last 24 hours: ${parts.join(", ")}.`;
+}
