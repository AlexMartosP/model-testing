+import { useEffect, useMemo, useState } from "react";
+import type { Home, Incident } from "../api.ts";
+import { getIncidents } from "../api.ts";
+import { formatHour, kindLabel, last24HourCells, summarizeHours } from "../format.ts";
+import type { HourSeverity } from "../format.ts";
+
+/** A letter inside each non-quiet cell, so the meaning never depends on colour alone. */
+const severityMark: Record<HourSeverity, string> = {
+  noise: "N",
+  occupancy: "O",
+  offline: "D",
+  none: "",
+};
+
+export function QuietHours({ home }: { home: Home }) {
+  const [incidents, setIncidents] = useState<Incident[] | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    setIncidents(null);
+    setError(null);
+    let current = true;
+    // All incidents, not just open ones: a resolved noise spike still coloured its hour.
+    getIncidents(home.id).then(
+      (rows) => { if (current) setIncidents(rows); },
+      (reason: unknown) => { if (current) setError(String(reason)); },
+    );
+    return () => {
+      current = false;
+    };
+  }, [home.id]);
+
+  const cells = useMemo(() => (incidents ? last24HourCells(incidents) : null), [incidents]);
+
+  return (
+    <section className="panel" aria-label={`Quiet hours for ${home.name}`}>
+      <h2>Quiet hours</h2>
+      <p className="muted">Last 24 hours, one cell per hour, oldest on the left, local time.</p>
+
+      {error && <p className="error">Could not load incidents: {error}</p>}
+      {!cells && !error && <p className="muted">Loading…</p>}
+
+      {cells && (
+        <>
+          <ol className="quiet-hours" tabIndex={0}>
+            {cells.map((cell) => {
+              const end = new Date(cell.start.getTime() + 3_600_000);
+              const when = `${formatHour(cell.start)} to ${formatHour(end)}`;
+              const what =
+                cell.severity === "none" ? "quiet" : kindLabel[cell.severity].toLowerCase();
+              return (
+                <li
+                  key={cell.start.getTime()}
+                  className={`quiet-hour ${cell.severity}`}
+                  aria-label={`${when}: ${what}`}
+                >
+                  <span className="quiet-hour-clock">{cell.start.getHours()}</span>
+                  {cell.severity !== "none" && (
+                    <span className="quiet-hour-mark" aria-hidden="true">
+                      {severityMark[cell.severity]}
+                    </span>
+                  )}
+                </li>
+              );
+            })}
+          </ol>
+
+          <p className="muted quiet-summary">{summarizeHours(cells)}</p>
+
+          <ul className="quiet-legend">
+            <li>
+              <span className="swatch noise" aria-hidden="true" /> Noise
+            </li>
+            <li>
+              <span className="swatch occupancy" aria-hidden="true" /> Occupancy
+            </li>
+            <li>
+              <span className="swatch offline" aria-hidden="true" /> Device offline
+            </li>
+            <li>
+              <span className="swatch none" aria-hidden="true" /> Quiet
+            </li>
+          </ul>
+        </>
+      )}
+    </section>
+  );
+}
