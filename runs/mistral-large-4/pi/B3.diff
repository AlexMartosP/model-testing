@@ -48,3 +48,15 @@ export function listIncidents(homeId: string, status?: IncidentStatus): Incident
 
 export const countOpenIncidents = (homeId: string): number =>
   incidents.filter((incident) => incident.homeId === homeId && incident.status === "open").length;
+
+export const findIncident = (homeId: string, incidentId: string): Incident | undefined =>
+  incidents.find((incident) => incident.homeId === homeId && incident.id === incidentId);
+
+/** Marks an open incident resolved, ending it now. Returns the updated incident. */
+export function resolveIncident(homeId: string, incidentId: string): Incident {
+  const incident = findIncident(homeId, incidentId);
+  if (!incident) throw new Error(`incident ${incidentId} not found in home ${homeId}`);
+  incident.status = "resolved";
+  incident.endedAt = new Date().toISOString();
+  return { ...incident };
+}
