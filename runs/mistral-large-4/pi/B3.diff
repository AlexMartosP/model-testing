+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { z } from "zod";
+import { createApp } from "../src/app.ts";
+
+/** Start the app on a free port for one test and shut it down afterwards. */
+async function withServer<T>(use: (base: string) => Promise<T>): Promise<T> {
+  const server = createApp().listen(0);
+  await new Promise((resolve) => server.once("listening", resolve));
+  const address = server.address();
+  if (address === null || typeof address === "string") throw new Error("server did not bind a port");
+  try {
+    return await use(`http://127.0.0.1:${address.port}`);
+  } finally {
+    await new Promise((resolve) => server.close(resolve));
+  }
+}
+
+/** `fetch`, with the body left as `unknown` so each test parses the shape it expects. */
+async function request(url: string, init?: RequestInit): Promise<{ status: number; body: unknown }> {
+  const res = await fetch(url, init);
+  return { status: res.status, body: await res.json() };
+}
+
+const incidentSchema = z.object({
+  id: z.string(),
+  homeId: z.string(),
+  kind: z.enum(["noise", "occupancy", "offline"]),
+  startedAt: z.string(),
+  endedAt: z.string().nullable(),
+  peakDb: z.number().nullable(),
+  status: z.enum(["open", "resolved"]),
+});
+
+const errorSchema = z.object({ error: z.string() });
+
+test("GET /api/homes/:homeId/incidents?status=open returns only open incidents", async () => {
+  await withServer(async (base) => {
+    const { status, body } = await request(`${base}/api/homes/h-01/incidents?status=open`);
+    assert.equal(status, 200);
+    const { incidents } = z.object({ incidents: z.array(incidentSchema) }).parse(body);
+    assert.deepEqual(incidents.map((incident) => incident.id), ["i-1001", "i-1003"]);
+    assert.ok(incidents.every((incident) => incident.status === "open"));
+  });
+});
+
+test("POST /api/homes/:homeId/incidents/:incidentId/resolve resolves an open incident", async () => {
+  await withServer(async (base) => {
+    const { status, body } = await request(`${base}/api/homes/h-03/incidents/i-1005/resolve`, {
+      method: "POST",
+    });
+    assert.equal(status, 200);
+    const { incident } = z.object({ incident: incidentSchema }).parse(body);
+    assert.equal(incident.id, "i-1005");
+    assert.equal(incident.status, "resolved");
+    assert.equal(typeof incident.endedAt, "string");
+
+    // The open list no longer includes it.
+    const list = await request(`${base}/api/homes/h-03/incidents?status=open`);
+    const { incidents } = z.object({ incidents: z.array(incidentSchema) }).parse(list.body);
+    assert.deepEqual(incidents.map((row) => row.id), ["i-1007"]);
+
+    // The home's open count dropped.
+    const home = await request(`${base}/api/homes/h-03`);
+    const { home: h } = z.object({
+      home: z.object({ openIncidents: z.number() }),
+    }).parse(home.body);
+    assert.equal(h.openIncidents, 1);
+  });
+});
+
+test("POST .../resolve is 409 for an already resolved incident", async () => {
+  await withServer(async (base) => {
+    const { status, body } = await request(`${base}/api/homes/h-01/incidents/i-1002/resolve`, {
+      method: "POST",
+    });
+    assert.equal(status, 409);
+    assert.equal(errorSchema.parse(body).error, "already_resolved");
+  });
+});
+
+test("POST .../resolve is 404 for an unknown incident", async () => {
+  await withServer(async (base) => {
+    const { status, body } = await request(`${base}/api/homes/h-01/incidents/i-9999/resolve`, {
+      method: "POST",
+    });
+    assert.equal(status, 404);
+    assert.equal(errorSchema.parse(body).error, "incident_not_found");
+  });
+});
+
+test("POST .../resolve is 404 for an unknown home", async () => {
+  await withServer(async (base) => {
+    const { status, body } = await request(`${base}/api/homes/h-99/incidents/i-1001/resolve`, {
+      method: "POST",
+    });
+    assert.equal(status, 404);
+    assert.equal(errorSchema.parse(body).error, "home_not_found");
+  });
+});
