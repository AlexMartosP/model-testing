+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { z } from "zod";
+import { createApp } from "../src/app.ts";
+
+/** Start the app on a free port for one test and shut it down afterwards. */
+async function withServer<T>(use: (base: string) => Promise<T>): Promise<T> {
+  const server = createApp().listen(0);
+  await new Promise((resolve) => server.once("listening", resolve));
+  const address = server.address();
+  if (address === null || typeof address === "string") throw new Error("server did not bind a port");
+  try {
+    return await use(`http://127.0.0.1:${address.port}`);
+  } finally {
+    await new Promise((resolve) => server.close(resolve));
+  }
+}
+
+/** `fetch`, with the body left as `unknown` so each test parses the shape it expects. */
+async function request(
+  url: string,
+  init?: RequestInit,
+): Promise<{ status: number; body: unknown }> {
+  const res = await fetch(url, init);
+  return { status: res.status, body: await res.json() };
+}
+
+const get = (url: string) => request(url);
+const post = (url: string) => request(url, { method: "POST" });
+
+const incidentSchema = z.object({
+  id: z.string(),
+  homeId: z.string(),
+  kind: z.enum(["noise", "occupancy", "offline"]),
+  startedAt: z.string(),
+  endedAt: z.string().nullable(),
+  peakDb: z.number().nullable(),
+  status: z.enum(["open", "resolved"]),
+});
+
+const errorSchema = z.object({ error: z.string() });
+
+// Note: the store is in-memory per process, so each test resolves a different incident.
+
+test("POST /api/homes/:homeId/incidents/:incidentId/resolve resolves an open incident", async () => {
+  await withServer(async (base) => {
+    const before = new Date();
+    const { status, body } = await post(`${base}/api/homes/h-01/incidents/i-1001/resolve`);
+    const after = new Date();
+
+    assert.equal(status, 200);
+    const { incident } = z.object({ incident: incidentSchema }).parse(body);
+    assert.equal(incident.id, "i-1001");
+    assert.equal(incident.homeId, "h-01");
+    assert.equal(incident.status, "resolved");
+    assert.ok(incident.endedAt !== null, "endedAt should be set");
+    const endedAt = new Date(incident.endedAt as string);
+    assert.ok(endedAt >= before && endedAt <= after, "endedAt should be roughly now");
+    // Untouched fields stay as they were.
+    assert.equal(incident.kind, "noise");
+    assert.equal(incident.startedAt, "2026-10-31T22:14:00Z");
+    assert.equal(incident.peakDb, 86);
+  });
+});
+
+test("a resolved incident shows up under state=resolved and leaves state=open", async () => {
+  await withServer(async (base) => {
+    const { status } = await post(`${base}/api/homes/h-03/incidents/i-1005/resolve`);
+    assert.equal(status, 200);
+
+    const open = await get(`${base}/api/homes/h-03/incidents?state=open`);
+    const openIds = z
+      .object({ incidents: z.array(incidentSchema) })
+      .parse(open.body)
+      .incidents.map((incident) => incident.id);
+    assert.deepEqual(openIds, ["i-1007"]);
+
+    const resolved = await get(`${base}/api/homes/h-03/incidents?state=resolved`);
+    const resolvedIds = z
+      .object({ incidents: z.array(incidentSchema) })
+      .parse(resolved.body)
+      .incidents.map((incident) => incident.id);
+    assert.ok(resolvedIds.includes("i-1005"));
+  });
+});
+
+test("resolving an incident lowers the home's open incident count", async () => {
+  await withServer(async (base) => {
+    const before = z
+      .object({ home: z.object({ openIncidents: z.number() }) })
+      .parse((await get(`${base}/api/homes/h-03`)).body).home.openIncidents;
+
+    const { status } = await post(`${base}/api/homes/h-03/incidents/i-1007/resolve`);
+    assert.equal(status, 200);
+
+    const after = z
+      .object({ home: z.object({ openIncidents: z.number() }) })
+      .parse((await get(`${base}/api/homes/h-03`)).body).home.openIncidents;
+    assert.equal(after, before - 1);
+  });
+});
+
+test("POST .../resolve is 404 home_not_found for an unknown home", async () => {
+  await withServer(async (base) => {
+    const { status, body } = await post(`${base}/api/homes/h-99/incidents/i-1001/resolve`);
+    assert.equal(status, 404);
+    assert.equal(errorSchema.parse(body).error, "home_not_found");
+  });
+});
+
+test("POST .../resolve is 404 incident_not_found for an unknown incident", async () => {
+  await withServer(async (base) => {
+    const { status, body } = await post(`${base}/api/homes/h-01/incidents/i-9999/resolve`);
+    assert.equal(status, 404);
+    assert.equal(errorSchema.parse(body).error, "incident_not_found");
+  });
+});
+
+test("POST .../resolve is 404 incident_not_found for another home's incident", async () => {
+  await withServer(async (base) => {
+    // i-1004 belongs to h-02, not h-01.
+    const { status, body } = await post(`${base}/api/homes/h-01/incidents/i-1004/resolve`);
+    assert.equal(status, 404);
+    assert.equal(errorSchema.parse(body).error, "incident_not_found");
+  });
+});
